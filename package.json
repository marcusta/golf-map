{
    "name": "golf-map",
    "private": true,
    "workspaces": [
        "server",
        "web",
        "shared"
    ],
    "scripts": {
        "start": "bun server/main.ts",
        "dev": "bun scripts/dev.ts",
        "start:vps": "SERVER_MODE=serve PORT=3801 DATA_DIR=./data DB_PATH=./data/app.sqlite SESSION_DB_PATH=./data/sessions.sqlite OBS_DB_PATH=./data/obs.sqlite WEB_DIST_DIR=./web/dist BODY_LIMIT=268435456 REQUEST_TIMEOUT=900000 TAPSCORE_BASE_URL=http://localhost:3737 bun server/main.ts",
        "db:migrate": "bun ./scripts/migrate.ts",
        "db:health": "bun ./scripts/health.ts",
        "feature-gates:generate": "bun ./scripts/generate-feature-gates.ts",
        "feature-gates:check": "bun ./scripts/generate-feature-gates.ts --check",
        "ios:deploy": "bash scripts/deploy-ios.sh",
        "trees:regen": "bun scripts/regen-trees-job.ts",
        "gspro:export": "bun scripts/gspro-export.ts",
        "gspro:status": "bun scripts/gspro-export.ts status",
        "gspro:update": "bun scripts/gspro-export.ts update",
        "photo": "bun scripts/cleaned-photo.ts",
        "gspro:bisect": "bun scripts/gspro-bisect.ts",
        "course:check": "bun scripts/course-check.ts",
        "zones": "bun scripts/vegetation-zones.ts",
        "grass:zones": "bun scripts/grass-zones.ts",
        "vegetation:rules": "bun scripts/vegetation-rules.ts",
        "terrain:generate": "bun scripts/terrain-generate.ts",
        "terrain:wall": "bun scripts/terrain-wall.ts",
        "features:union": "bun scripts/features-union.ts",
        "water:edge": "bun scripts/water-edge.ts",
        "water:steps": "bun scripts/water-steps.ts",
        "trees:photo": "bun scripts/trees-photo.ts",
        "water:import": "bun scripts/water-import.ts",
        "shaping": "bun scripts/shaping-apply.ts",
        "shaping:worker": "bun scripts/shaping-worker.ts",
        "arborist": "bun scripts/arborist.ts",
        "models": "bun scripts/models.ts",
        "opcd:build": "bun scripts/opcd-build.ts",
        "e2e": "playwright test --config e2e/playwright.config.ts",
        "e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
        "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
        "e2e:create": "playwright test --config e2e/playwright.config.ts \"e2e/tests/(01|07|08|09|17|19|24|25|28|32)-\"",
        "e2e:durations": "bun e2e/durations.ts",
        "e2e:reordered": "bun e2e/reorder-specs.ts && E2E_TEST_DIR=e2e/.tests-reordered playwright test --config e2e/playwright.config.ts",
        "py": "bun scripts/py.ts",
        "unity:new-project": "bun scripts/unity-new-project.ts",
        "yt": "bun scripts/yt-transcript.ts",
        "test:scripts": "bun scripts/assert-not-linked.ts && bun test ./scripts/",
        "fw:update": "bun ../mackans-client-fw/tools/update.ts",
        "fw:check": "bun scripts/assert-not-linked.ts"
    },
    "dependencies": {
        "@basics/core": "file:./vendor/basics-core-1.1.0.tgz",
        "kysely": "^0.27",
        "kysely-bun-sqlite": "^0.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@types/bun": "^1"
    }
}
