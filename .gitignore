node_modules
data/*.sqlite*
dist
.DS_Store
uploads

# E2E harness (Playwright) — isolated seeded DBs, storageState, reports
e2e/.tmp
e2e/test-results
e2e/results
e2e/playwright-report
# Playwright also drops its output at the repo root when run from here
/test-results
# Generated by e2e/reorder-specs.ts (order-independence proof runs)
e2e/.tests-reordered

# Python tile pipeline (pipeline/) and Python tools (tools/)
pipeline/.venv
tools/sam-server/venv
pipeline/**/__pycache__
pipeline/**/*.egg-info
tools/**/__pycache__
__pycache__/
.pytest_cache
.env
data/

# Third-party GSPro/OPCD reference bundle (QGIS support files, PDFs) —
# downloaded material, not project source
gspro-files/

# ATDD: transient per-feature freeze manifest (written by /atdd, removed on unfreeze)
.claude/atdd-frozen.json

# CodeGraph local index (indexing is per-developer, not shared)
.codegraph/

# sig-infra deploy scratch: db_pull drops a production DB snapshot here
# (deploy-tmp/db.sqlite) for local migration rehearsal. Real user data —
# must never be committed. deploy_preflight warns if this line is missing.
deploy-tmp/

# Unity tree catalogue exports and parity runs (generated, hundreds of MB)
tree-export/

# Export input fingerprints (export-fingerprint.ts): what a generated file was
# last built from on THIS machine. The props chain leaves one next to the spec
# it writes under docs/gspro/<course>/ — a build stamp, not project source.
docs/gspro/**/*.inputs.json
