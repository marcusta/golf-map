{
  "comment": "The Arborist catalogue assets golf-map plants, and the VSP vegetation type each is added as. unity/ArboristMod/library.ts adds every match to a 'GolfMap library' biome inside a running Arborist (which sets its own default item settings and bakes the billboards) and exports it; pipeline/arborist.py clones its items from that file. A name is matched against the asset's label, case-insensitively; exclude wins.",
  "exclude": ["_Fall", "Autumn", "Autmn", "_Bare", "Snow", "_static", "Topiary", "leaves_01"],
  "groups": [
    { "type": "Tree", "match": ["S7_European_White_Birch", "S7_River_Birch", "MountainEnv_Forest_pine_0", "MountainEnv_Forest_pine_tree_00", "MountainEnv_Forest_pine_10_dead", "NM_Fir_02", "NM_Fir_03", "NM_Fir_04", "NM_Fir_05", "NM_Fir_06", "NM_Fir_07", "NM_Fir_08_Dead", "MeadowEnv_02_Poplar", "MeadowEnv_03_Poplar", "MeadowEnv_04_Poplar", "MeadowEnv_05_Poplar", "MeadowEnv_06_Poplar", "MeadowEnv_07_Poplar", "MeadowEnv_08_Poplar", "Oak__", "S7_White_Oak", "S7_EuropeanLinden", "CE_Maple_", "S7_American_Elm", "Forest_beech_small_tree", "Forest_Large_beech_tree", "AmericanBeech_Moline", "Hazel_Moline", "CE_DA_Forest_Tree_", "Black_Gum_Moline", "S7_Hedge_", "CE_Oak", "ModdedOak"], "exclude": ["_log", "_roots", "_Winter"] },
    { "type": "Plant", "match": ["billberry", "lingonberry", "MountainEnv_heath_", "Forest_fern_", "S7_Red_Fern", "MountainEnv_bush_hazel", "MeadowEnv_bush_grey_willow", "MeadowEnv_maple_bush", "Forest_beech_plant", "MeadowEnv_00_Poplar_plant", "MountainEnv_Forest_pine_plant", "NM_Fir_01_Plant", "bush_dwarf_pine", "Forest_detail_moss"], "exclude": ["_Winter"] },
    { "type": "Objects", "match": ["MountainEnv_pine_stump", "MountainEnv_Pine_roots", "MountainEnv_roots_slope", "MountainEnv_Pine_broken_branch", "Forest_detail_branches", "MountainEnv_branch_", "MeadowEnv_wood_log", "MeadowEnv_half_log", "MountainEnv_Pine_cone", "MountainEnv_Forest_pine_04_log", "MountainEnv_Forest_pine_04_0", "MountainEnv_Forest_Pine_09_log", "MountainEnv_Forest_pine_08_Log", "mushroom"], "exclude": ["Tee_Black", "_Winter"] },
    { "type": "Tree", "match": ["S7_AmurCork_Winter"], "comment": "Omberg hole 18's dead oak (2026-10-18): Arborist's leafless Amur cork, bleached by its model look; the other groups still leave _Winter variants out." },
    { "type": "Plant", "match": ["CE_Plants_buckthorn-bush"], "comment": "Omberg hole 14's round bush in front of the big pine (2026-10-18): the densest round bush in the catalogue, lightened by its model look." }
  ]
}
