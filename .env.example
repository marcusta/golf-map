# Copy to .env and fill in. Lantmäteriet account (free) for STAC asset downloads.
LANTMATERIET_USER=your-username
LANTMATERIET_PASS=your-password
# Trafikverket open data API key (free, data.trafikverket.se → Registrera → Skapa nyckel).
# fetch-roads uses it for NVDB road widths, paved/gravel and roads OSM lacks; without it roads are OSM only.
TRAFIKVERKET_API_KEY=your-api-key
