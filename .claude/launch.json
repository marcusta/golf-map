{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "server",
            "runtimeExecutable": "bun",
            "runtimeArgs": ["run", "dev:server"],
            "cwd": "server",
            "port": 3000
        },
        {
            "name": "demo",
            "runtimeExecutable": "bun",
            "runtimeArgs": ["run", "demo"],
            "cwd": "web",
            "port": 5180
        },
        {
            "name": "web",
            "runtimeExecutable": "bun",
            "runtimeArgs": ["run", "dev"],
            "cwd": "web",
            "port": 5173,
            "autoPort": true
        },
        {
            "name": "web-c4",
            "runtimeExecutable": "bun",
            "runtimeArgs": ["run", "dev"],
            "cwd": "web",
            "port": 5273,
            "autoPort": true
        },
        {
            "name": "web-c3",
            "runtimeExecutable": "bun",
            "runtimeArgs": ["run", "dev"],
            "cwd": "web",
            "port": 5373,
            "autoPort": true
        },
        {
            "name": "api-e2e",
            "runtimeExecutable": "powershell",
            "runtimeArgs": [
                "-NoProfile", "-Command",
                "$tmp = (Resolve-Path ..).Path + '\\e2e\\.tmp'; $env:PORT='3100'; $env:DATA_DIR=(Resolve-Path ../data).Path; $env:DB_PATH=\"$tmp\\preview-app.sqlite\"; $env:SESSION_DB_PATH=\"$tmp\\preview-sessions.sqlite\"; $env:OBS_DB_PATH=\"$tmp\\preview-obs.sqlite\"; $env:CROSS_ORIGIN_RESOURCE_POLICY='same-site'; bun db/seed-e2e.ts $env:DB_PATH; if ($LASTEXITCODE -eq 0) { bun main.ts }"
            ],
            "cwd": "server",
            "port": 3100
        },
        {
            "name": "web-e2e",
            "runtimeExecutable": "powershell",
            "runtimeArgs": ["-NoProfile", "-Command", "$env:PORT='5274'; $env:API_PROXY_TARGET='http://localhost:3100'; bunx vite"],
            "cwd": "web",
            "port": 5274
        }
    ]
}
